# Optional. Core planning and local PDF extraction work without a key.
# Copy to .env.local; never add NEXT_PUBLIC_ to this variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Any OpenAI-compatible endpoint. For Google Gemini use
# https://generativelanguage.googleapis.com/v1beta/openai/ with a Gemini key,
# OPENAI_MODEL=gemini-3.5-flash-lite and OPENAI_EMBEDDING_MODEL=gemini-embedding-001.
OPENAI_BASE_URL=
# Used by npm run build:index and /api/ask with use_ai. Changing either requires --rebuild.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=512
# AI budget guard shared by /api/ask, /api/goal and /api/plan (defaults shown).
AI_RATE_PER_MINUTE=5
AI_RATE_PER_DAY=30
AI_RATE_GLOBAL_PER_DAY=300

# Same-origin APIs are the default. Enable only for an explicitly labeled demo.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_USE_MOCK_DATA=false
NEXT_PUBLIC_USE_MOCK_TRANSCRIPT=false

# Hosted $0 demo: blocks external AI even if an API key is accidentally configured.
# build:free and vercel.json enable these; local development defaults remain unchanged.
DEGREEGPS_FREE_DEMO=false
NEXT_PUBLIC_FREE_DEMO=false
