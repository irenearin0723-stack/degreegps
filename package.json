{
  "name": "degreegps",
  "private": true,
  "version": "2.0.0",
  "description": "Shared DegreeGPS API contract for DubHacks",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run typecheck && npm run validate:data && npm test && npm run check:mock",
    "check:mock": "node --conditions=react-server --import tsx scripts/check-contract.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "validate:data": "node --conditions=react-server --import tsx scripts/validate-data.ts",
    "validate:data:artifacts": "python3 scripts/validate-data-artifacts.py",
    "verify:http": "node --import tsx scripts/verify-http.ts"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pdf-lib": "^1.17.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0",
    "openai": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "server-only": "^0.0.1"
  }
}
